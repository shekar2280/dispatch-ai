# Use an isolated Supabase project. Apply apps/api/database/schemas/schema.sql and
# subsequent migrations in date order before starting the application.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key
DATABASE_URL=postgresql+asyncpg://user:password@your-supabase-db-host:5432/postgres
ADMIN_SECRET_KEY=replace_with_a_long_random_secret
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required only for the optional voice worker and telephony flows.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_DOMAIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
VOICE_ENABLED=true
VOICE_GEMINI_RPM=15
VOICE_GEMINI_TPM=250000
VOICE_GEMINI_RPD=500
VOICE_GROQ_RPM=30
VOICE_GROQ_TPM=8000
VOICE_GROQ_RPD=1000
VOICE_GROQ_MAX_COMPLETION_TOKENS=128
# GPT-OSS supports low, medium, high; none is not supported.
VOICE_GROQ_REASONING_EFFORT=low
VOICE_LLM_MAX_OUTPUT_TOKENS=128
VOICE_LLM_MAX_HISTORY_TURNS=4
VOICE_GLOBAL_CONCURRENCY=1
VOICE_GLOBAL_DAILY_SECONDS=1800
VOICE_MAX_CALL_SECONDS=120
VOICE_ADMISSION_TTL_SECONDS=45
VOICE_TTS_DAILY_CHARACTERS=100000
VOICE_PREVIEW_RPM=3
VOICE_AUDIO_RETENTION_DAYS=7
VOICE_TRANSCRIPT_RETENTION_DAYS=30
ELEVENLABS_API_KEY=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_POOL_PRE_PING=true
VOICE_MAX_CONCURRENT_CALLS_PER_ORG=10
VOICE_MAX_CONCURRENT_CALLS_GLOBAL=100
